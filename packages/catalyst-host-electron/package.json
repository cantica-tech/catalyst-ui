{
  "name": "catalyst-host-electron",
  "version": "0.55.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --build --force",
    "prebuild": "npm run build:renderer",
    "build:renderer": "esbuild src/renderer-entry.tsx --bundle --minify --outfile=dist/renderer.js --format=iife --platform=browser --jsx=automatic",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "dist": "npm run bundle && electron-builder --publish never"
  },
  "dependencies": {
    "catalyst-core": "*",
    "catalyst-studio": "*",
    "catalyst-ui": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron": "^30.0.0",
    "esbuild": "^0.21.5",
    "vitest": "^1.4.0",
    "electron-builder": "^25.1.8"
  }
}
