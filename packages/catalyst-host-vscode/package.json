{
  "name": "catalyst-host-vscode",
  "version": "0.8.0",
  "private": true,
  "license": "UNLICENSED",
  "publisher": "CanticaTech",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliben67/catalyst-ui.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "catalyst",
          "title": "Catalyst",
          "icon": "resources/catalyst.svg"
        }
      ]
    },
    "views": {
      "catalyst": [
        {
          "id": "catalystChainInspector",
          "name": "Chain Inspector",
          "icon": "resources/catalyst.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "catalyst.showNodeDetail",
        "title": "Catalyst: Show Node Detail"
      },
      {
        "command": "catalyst.showIamDetail",
        "title": "Catalyst: Show User/Role Detail"
      },
      {
        "command": "catalyst.openJournal",
        "title": "Catalyst: Open Journal"
      },
      {
        "command": "catalyst.openBacklog",
        "title": "Catalyst: Open Backlog"
      },
      {
        "command": "catalyst.proposeFix",
        "title": "Catalyst: Propose Fix"
      },
      {
        "command": "catalyst.composeProposal",
        "title": "Catalyst: Compose Proposal"
      },
      {
        "command": "catalyst.sendToAgentChat",
        "title": "Catalyst: Send to Agent (Chat)…",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "catalyst.sendToAgentChat",
          "when": "view == catalystChainInspector",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Catalyst",
      "properties": {
        "catalyst.frameworkPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local checkout of the catalyst framework repository (containing BOOTSTRAP.md), used by the install-offer when a workspace folder has no catalyst deployment. Only needed if the framework repo isn't cloned as a sibling of your project."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build --force",
    "prebuild": "npm run build:webview --workspace=catalyst-ui && mkdir -p dist && cp ../catalyst-ui/dist/webview.js dist/webview.js",
    "test": "mocha \"dist/test/**/*.test.js\"",
    "pretest": "npm run build",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --external:fsevents --outfile=dist/extension.js",
    "package": "npm run build && npm run bundle && npx vsce package --no-dependencies -o catalyst-host-vscode.vsix",
    "publish": "npm run build && npm run bundle && npx vsce publish --no-dependencies"
  },
  "dependencies": {
    "catalyst-core": "^0.8.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.27.0",
    "esbuild": "^0.21.5",
    "mocha": "^10.3.0"
  }
}
