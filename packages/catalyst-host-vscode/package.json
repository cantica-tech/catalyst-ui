{
  "name": "catalyst-host-vscode",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "catalyst",
          "title": "Catalyst",
          "icon": "resources/catalyst.svg"
        }
      ]
    },
    "views": {
      "catalyst": [
        {
          "id": "catalystChainInspector",
          "name": "Chain Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "catalyst.showNodeDetail",
        "title": "Catalyst: Show Node Detail"
      },
      {
        "command": "catalyst.proposeFix",
        "title": "Catalyst: Propose Fix"
      },
      {
        "command": "catalyst.composeProposal",
        "title": "Catalyst: Compose Proposal"
      }
    ]
  },
  "scripts": {
    "build": "tsc --build --force",
    "prebuild": "npm run build:webview --workspace=catalyst-ui",
    "test": "mocha \"dist/test/**/*.test.js\"",
    "pretest": "npm run build"
  },
  "dependencies": {
    "catalyst-core": "^0.4.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "mocha": "^10.3.0"
  }
}
