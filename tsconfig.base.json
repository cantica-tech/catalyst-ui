{
  "extends": "./.standards/tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Ratchet (2026-10-09, standards v0.1.0): 126 unchecked index accesses predate the standard; true once fixed.
    "noUncheckedIndexedAccess": false
  }
}
